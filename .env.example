# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed. This file holds PLACEHOLDERS ONLY.

# --- MongoDB Atlas (free M0) -------------------------------------------------
# Atlas > Connect > Drivers > C#/.NET. Replace the placeholders with your own.
# A replica set is required for transactions; every Atlas cluster is one.
Mongo__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
Mongo__Database=inventoryhold

# --- Upstash Redis (free) ----------------------------------------------------
# Upstash console > your database > Connect > "StackExchange.Redis" tab.
Redis__ConnectionString=<endpoint>.upstash.io:6379,password=<password>,ssl=True,abortConnect=False

# --- CloudAMQP RabbitMQ (free Little Lemur) ----------------------------------
# CloudAMQP > instance > AMQP URL.
RabbitMq__Uri=amqps://<user>:<password>@<host>.cloudamqp.com/<vhost>

# --- Business configuration --------------------------------------------------
# Fractional values are allowed, so a demo can use seconds (0.1 = 6 seconds).
Hold__ExpirationMinutes=15
