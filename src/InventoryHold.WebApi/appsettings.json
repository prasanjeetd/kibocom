{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB": "Warning"
    },
    "Feed": {
      "MinimumLevel": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "Database": "inventoryhold",
    "UseTransactions": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InventoryTtlSeconds": 30,
    "Enabled": true
  },
  "RabbitMq": {
    "Uri": "amqp://guest:guest@localhost:5672/",
    "Exchange": "inventory.holds",
    "AuditQueue": "inventory.holds.audit",
    "Enabled": true
  },
  "Hold": {
    "ExpirationMinutes": 15,
    "SweeperIntervalSeconds": 15,
    "SweeperBatchSize": 100
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173", "http://localhost:8080" ]
  }
}
